+def _dense_experts_forward(self, hidden_states, top_k_index, top_k_weights):
+    """Dense chunked expert GEMMs on the fused weights.
+
+    The stock implementation loops over 256 experts and scatter-adds each
+    expert's output, which is latency-bound (~3.8 s/step at 5k tokens).
+    Computing all experts densely costs 32x the routed FLOPs but runs as a
+    handful of large GEMMs; non-selected experts are zero-weighted.
+    """
+    total_tokens, hidden_dim = hidden_states.shape
+    num_experts = self.num_experts
+    intermediate = self.intermediate_dim
+    routing = hidden_states.new_zeros((total_tokens, num_experts))
+    routing.scatter_(1, top_k_index, top_k_weights.to(hidden_states.dtype))
+    gate_up_w = self.gate_up_proj.reshape(
+        num_experts * 2 * intermediate, hidden_dim
+    ).t()
+    down_w = self.down_proj.transpose(1, 2)
+    use_ckpt = self.training and torch.is_grad_enabled()
+    outs = []
+    for start in range(0, total_tokens, _DENSE_MOE_CHUNK):
+        chunk_h = hidden_states[start : start + _DENSE_MOE_CHUNK]
+        chunk_w = routing[start : start + _DENSE_MOE_CHUNK]
+
