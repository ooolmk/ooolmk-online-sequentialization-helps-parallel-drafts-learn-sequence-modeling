+        logits = logits[:, :seq_len]
+        targets = targets[:, :seq_len]
+        loss_mask = loss_mask[:, :seq_len]
+    start = 0 if sample_from_anchor else 1
+    loss_mask = loss_mask.to(torch.float32)
+
+    target_ids = torch.argmax(targets, dim=-1)
+    draft_logp = torch.nn.functional.log_softmax(
+        logits, dim=-1, dtype=torch.float32
+    )
+    p = torch.exp(
+        torch.gather(draft_logp, -1, target_ids.unsqueeze(-1)).squeeze(-1)
+    )  # shape: [batch, seq_len]
+
+    p_b = p.reshape(batch_size, -1, block_size)[:, :, start:]
+    m_b = loss_mask.reshape(batch_size, -1, block_size)[:, :, start:]
+    block_w = m_b.prod(dim=-1)  # 1.0 only when every drafted slot is valid
+    eal = torch.cumprod(p_b, dim=-1).sum(dim=-1)  # shape: [batch, num_blocks]
+    denom = block_w.sum().clamp(min=1.0)
+    total = -(eal * block_w).sum() / denom
+
+    if kl_coef > 0.0:
+        # Drift anchor. KL(draft || target) = CE(target) - H(target), and
+        # H(target) is constant w.r.t. draft parameters, so a per-position
+        # CE to the target's greedy token yields gradients identical to the
+        # KL anchor. Computed via logsumexp + gather so no full-width fp32
+        # log_softmax / softmax buffers are materialized (the plain
+        # kl_div_loss path adds ~2 x seq_len x vocab x 4 bytes and OOMs on
+        # memory-tight GPUs).
+        mask_sum = loss_mask.sum().clamp(min=1.0)
+        target_ids = torch.argmax(targets, dim=-1)
+        ce_total = torch.zeros((), device=logits.device, dtype=torch.float32)
+        chunk = 4096
+        for s in range(0, seq_len, chunk):
+            e = min(s + chunk, seq_len)
+            lse = torch.logsumexp(logits[:, s:e].to(torch.float32), dim=-1)
+            q_y = torch.gather(
+                logits[:, s:e].to(torch.float32),
+                -1,
