+            act = self.act_fn(gate) * up
+            act = act * ww.unsqueeze(-1)
+            y = torch.bmm(act.permute(1, 0, 2), down_w)
+            return y.sum(dim=0)
+
+        if use_ckpt:
+            outs.append(
+                checkpoint(
+                    _chunk,
+                    chunk_h,
+                    chunk_w,
+                    use_reentrant=False,
+                    preserve_rng_state=False,
+                )
+            )
+        else:
+            outs.append(_chunk(chunk_h, chunk_w))
+    return torch.cat(outs, dim=0)
