+def eal_exact_loss(
+    logits: torch.Tensor,  # shape: [1, seq_len, draft_vocab_size]
+    targets: torch.Tensor,  # shape: [1, seq_len, draft_vocab_size]
+    loss_mask: torch.Tensor,  # shape: [1, seq_len]
+    block_size: int = 8,
+    sample_from_anchor: bool = False,
+    kl_coef: float = 0.0,
+) -> torch.Tensor:
+    """Block-level expected accepted length (EAL) loss for DFlash drafting.
+
+    For each valid block, with p_i the draft softmax probability of the
+    target's greedy token y_i at drafted slot i, the loss is
+
+        L_EAL = -(p_1 + p_1 p_2 + ... + p_1 ... p_7) / num_valid_blocks
+
+    Each term prod_{i<=j} p_i is the probability that the first j draft
+    tokens are all accepted, so the objective is the exact expected
+    accepted-prefix length under the parallel-position independence
+    assumption. Position i's gradient is weighted by the probability that
+    all earlier positions are accepted (prefix gating), which gives
+    credit assignment: suffixes after a likely-first-error stop receiving
+    gradient without any hard mask. Only fully valid blocks (all drafted
+    slots in the loss mask) contribute; boundary blocks are dropped.
+
+    When ``kl_coef > 0`` a masked-mean anchor against the target is added.
+    It is computed as per-position CE to the target's greedy token, which has
+    gradients identical to forward KL (the entropy of the target is constant
+    w.r.t. draft parameters) at a fraction of the memory.
+    """
+    batch_size, seq_len, _ = logits.shape
