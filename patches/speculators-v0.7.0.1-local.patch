+def _draft_token_acceptance(
+    logits: torch.Tensor, targets: torch.Tensor
+) -> torch.Tensor:
+    """Return the target acceptance probability of the draft's greedy token.
+
+    This is the local, offline analogue of the target re-score used by OPD:
+    the token selected by the draft is looked up in both distributions and the
+    rejection-sampling acceptance probability ``min(1, p/q)`` is computed.
+    The result is detached by callers when it is used as a loss weight, so it
+    does not create a non-differentiable argmax path through the objective.
+    """
+    draft_logp = torch.nn.functional.log_softmax(logits, dim=-1, dtype=torch.float32)
+    target_logp = torch.nn.functional.log_softmax(targets, dim=-1, dtype=torch.float32)
+    draft_ids = torch.argmax(logits, dim=-1, keepdim=True)
+    draft_selected = torch.gather(draft_logp, -1, draft_ids).squeeze(-1)
+    target_selected = torch.gather(target_logp, -1, draft_ids).squeeze(-1)
+    ratio = torch.exp((target_selected - draft_selected).clamp(min=-30.0, max=30.0))
+    return ratio.clamp(max=1.0)
+
+
+def opd_loss(
+    logits: torch.Tensor, targets: torch.Tensor
+) -> torch.Tensor:
+    """Acceptance-aware offline OPD surrogate.
+
+    The target distribution is re-scored at the draft greedy token and the
+    resulting acceptance probability up-weights forward KL on rejected draft
+    tokens.  This keeps the dense teacher gradient while making the objective
+    sensitive to the token sequence emitted by the current draft.  It is an
+    offline surrogate because the existing hidden-state corpus does not carry
+    a freshly rolled-out draft prefix.
+    """
+    base = kl_div_loss(logits, targets)
+    acceptance = _draft_token_acceptance(logits, targets).detach()
+    return base * (1.0 + 2.0 * (1.0 - acceptance))
+
+
+def opd_first_error_loss(
+    logits: torch.Tensor, targets: torch.Tensor
+) -> torch.Tensor:
+    """OPD surrogate with first-error position weighting for DFlash blocks.
+
+    For the fixed DFlash block size of eight, positions before the first
+    rejected draft token receive weight 0.25, the first error receives 1.0,
+    and the suffix receives 0.05.  Fully accepted blocks keep weight 1.0.
+    """
+    base = opd_loss(logits, targets)
+    seq_len = logits.shape[1]
+    if seq_len % 8 != 0:
+        return base
+    correct = torch.argmax(logits, dim=-1).eq(torch.argmax(targets, dim=-1))
+    correct = correct.reshape(-1, 8)
+    # DFlash slot 0 is the anchor, not a speculative prediction.
+    rejected = ~correct[:, 1:]
+    has_rejection = rejected.any(dim=-1, keepdim=True)
+    first_error = rejected.to(torch.int64).argmax(dim=-1, keepdim=True)
+    positions = torch.arange(7, device=logits.device).view(1, 7)
+    weighted = torch.where(
+        positions < first_error,
+        torch.full_like(positions, 0.25, dtype=torch.float32),
+        torch.where(
+            positions == first_error,
+            torch.ones_like(positions, dtype=torch.float32),
+            torch.full_like(positions, 0.05, dtype=torch.float32),
+        ),
+    )
+    weighted = torch.where(has_rejection, weighted, torch.ones_like(weighted))
+    # Preserve an unused slot-0 weight for shape alignment; its loss mask is 0.
+    anchor_weight = torch.ones((weighted.shape[0], 1), device=logits.device)
+    return base * torch.cat((anchor_weight, weighted), dim=1).reshape(1, seq_len)
+
+
+def opd_accept_reward_loss(
+    logits: torch.Tensor, targets: torch.Tensor
+) -> torch.Tensor:
+    """OPD plus a differentiable expected accepted-length reward.
+
+    For each draft position, ``sum(min(p, q))`` is the rejection-sampling
+    overlap between target and draft.  The product of overlaps over the
+    accepted prefix is the expected probability of reaching that position.
+    This term therefore gives a direct, dense surrogate for the seven-token
+    DFlash accepted length.  A small coefficient keeps the OPD KL gradient as
+    the main stabilizing signal.  It is not a high-variance REINFORCE update:
+    the target distribution and expected reward are available from the static
+    hidden-state batch.
+    """
+    seq_len = logits.shape[1]
+    if seq_len % 8 != 0:
+        return ce_loss(logits, targets)
+    base = opd_loss(logits, targets)
+    draft_p = torch.nn.functional.softmax(logits, dim=-1, dtype=torch.float32)
+    target_p = torch.nn.functional.softmax(targets, dim=-1, dtype=torch.float32)
+    overlap = torch.minimum(draft_p, target_p).sum(dim=-1)
+    overlap = overlap.reshape(-1, 8)[:, 1:].clamp(min=0.0, max=1.0)
+    expected_eal = torch.cumprod(overlap, dim=-1).sum(dim=-1).mean() / 7.0
+    eal_deficit = 1.0 - expected_eal
+    return base + 0.5 * eal_deficit
+
